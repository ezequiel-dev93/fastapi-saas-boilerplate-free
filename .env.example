# Application
PROJECT_NAME="FastAPI SaaS Boilerplate"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-secret-key-in-production-min-32-chars-long
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4321,http://localhost:8000"

# Database (Default: SQLite for local, replace with PostgreSQL for production)
DATABASE_URL="sqlite:///./saas.db"
# Example PostgreSQL: postgresql+psycopg://user:password@localhost:5432/saas_db

# Stripe Settings
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_default_price_id
STRIPE_API_VERSION=2026-08-26.dahlia

# AWS Cognito Authentication (Optional in development thanks to Dev JWT Login)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AI Engine (Multi-Provider: mock, openai, gemini, claude)
AI_PROVIDER=mock
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS SES / SMTP Email Settings
SES_FROM_EMAIL=noreply@yourdomain.com
USE_DEV_SMTP=True
SMTP_HOST=localhost
SMTP_PORT=1025

# Redis & Worker
REDIS_URL="redis://localhost:6379/0"

