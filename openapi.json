  "paths": {
    "/api/v1/auth/dev-users": {
      "get": {
        "tags": [
          "Autenticación"
        ],
        "summary": "List Dev Users",
        "description": "Retorna la lista de usuarios locales para inicio de sesión rápido en desarrollo.\nEstrictamente prohibido y deshabilitado (404) en producción.",
        "operationId": "list_dev_users_api_v1_auth_dev_users_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DevUserRead"
                  },
                  "type": "array",
                  "title": "Response List Dev Users Api V1 Auth Dev Users Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/dev-login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Dev Login",
        "description": "Genera un JWT válido para el usuario especificado en entorno de desarrollo.\nSi el usuario no existe en la base de datos local, lo aprovisiona automáticamente.\nEstrictamente prohibido y deshabilitado (404) en producción.",
        "operationId": "dev_login_api_v1_auth_dev_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevLoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
